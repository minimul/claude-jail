#!/bin/bash
set -eo pipefail

IMAGE_NAME="claude-jail"
HOST_PWD="$(pwd)"
SCRIPT_PATH="$(readlink -f "$0")"
FORCE_REBUILD=false
NO_CACHE=false
SHELL_MODE=false
RESUME_SESSION=""
CONTINUE_SESSION=false
SAFE_PERMISSIONS=false
PASSTHROUGH_ARGS=()
ENV_VARS=()
EXTRA_NETWORKS=()
: "${USER:=$(id -un)}"

# ============================================
# Custom apt packages to install (space-separated)
# Modify this line to add your own packages
CUSTOM_APT_PACKAGES="jq"
# ============================================

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --rebuild|-r)
            FORCE_REBUILD=true
            shift
            ;;
        --no-cache)
            NO_CACHE=true
            shift
            ;;
        --shell|-s)
            SHELL_MODE=true
            shift
            ;;
        --resume|-R)
            RESUME_SESSION="$2"
            shift 2
            ;;
        --continue|-c)
            CONTINUE_SESSION=true
            shift
            ;;
        --safe)
            SAFE_PERMISSIONS=true
            shift
            ;;
        -e|--env)
            if [ -z "${2:-}" ]; then
                echo "Error: $1 requires a VALUE (e.g. -e KEY=VALUE)" >&2
                exit 1
            fi
            ENV_VARS+=("$2")
            shift 2
            ;;
        -n|--network)
            if [ -z "${2:-}" ]; then
                echo "Error: $1 requires a NETWORK name" >&2
                exit 1
            fi
            EXTRA_NETWORKS+=("$2")
            shift 2
            ;;
        --help|-h)
            echo "Usage: $0 [OPTIONS] [-- ARGS...]"
            echo ""
            echo "Options:"
            echo "  -e,  --env KEY=VAL    Pass an environment variable to the container (repeatable)"
            echo "  -n,  --network NAME   Attach the jail container to an extra docker network (repeatable)"
            echo "  -r,  --rebuild        Force rebuild of the Docker image"
            echo "       --no-cache       Rebuild without using Docker cache"
            echo "  -s,  --shell          Start a bash shell instead of claude"
            echo "  -R,  --resume UID     Resume a previous session by its ID"
            echo "  -c,  --continue       Continue the most recent session"
            echo "       --safe           Do NOT pass --dangerously-skip-permissions to claude"
            echo "  -h,  --help           Show this help message"
            echo ""
            echo "Arguments after -- are passed through to claude."
            echo ""
            echo "Compose-scoped docker access:"
            echo "  The host docker socket is mounted into the jail and a filtering"
            echo "  shim is installed at /usr/local/bin/docker.  The shim only permits"
            echo "  operations against containers whose compose project working_dir"
            echo "  matches \$(pwd) at launch time.  All host-wide commands"
            echo "  (run/create/build/network/volume/system/...) are blocked."
            echo ""
            echo "  The shim is a soft fence (curl-to-socket bypasses it).  Do not"
            echo "  treat it as a sandbox primitive."
            echo ""
            echo "Landlock filesystem confinement:"
            echo "  The container command is prefixed with landlock-exec, which seals"
            echo "  the claude process tree (and all descendants) so it can only write"
            echo "  the workspace, ~/.claude, and /tmp, and can only read the rest of"
            echo "  the rootfs.  It cannot overwrite the docker shim or any system file."
            echo "  Control via the CLAUDE_JAIL_LANDLOCK env var (pass with -e):"
            echo "    enforce  (default) apply rules; warn+run unconfined if the kernel"
            echo "             lacks Landlock"
            echo "    strict   abort if Landlock cannot be applied"
            echo "    off      disable confinement"
            echo ""
            echo "Compose network auto-attach:"
            echo "  If a docker compose project is currently running with its"
            echo "  working_dir equal to \$(pwd), claude-jail also attaches the jail"
            echo "  container to every network those compose containers are on, so"
            echo "  claude can reach the services by their compose service name"
            echo "  (e.g. http://web:3000).  Use -n/--network to attach extra"
            echo "  networks on top of that."
            exit 0
            ;;
        --)
            shift
            PASSTHROUGH_ARGS+=("$@")
            break
            ;;
        *)
            echo "Error: Unknown option '$1'" >&2
            echo "Run '$0 --help' for usage." >&2
            exit 1
            ;;
    esac
done

# Create claude-home data directories
claude_data="$HOME/.claude-home"
mkdir -p "$claude_data/.claude"
touch "$claude_data/.claude.json"
# Seed .claude/settings.local.json with crimson MCP server config if missing or empty
if [ ! -s "$claude_data/.claude/settings.local.json" ]; then
    cat > "$claude_data/.claude/settings.local.json" <<'LOCALJSON'
{
  "mcpServers": {
    "crimson": {
      "type": "stdio",
      "command": "crimson",
      "args": ["mcp"]
    }
  }
}
LOCALJSON
fi

# Compute hash of this script to detect changes
SCRIPT_HASH=$(md5sum "$SCRIPT_PATH" | cut -d' ' -f1)

# Check if rebuild is needed
NEEDS_BUILD=false
if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
    echo "Image '$IMAGE_NAME' not found. Building..."
    NEEDS_BUILD=true
elif [ "$FORCE_REBUILD" = true ] || [ "$NO_CACHE" = true ]; then
    echo "Forcing rebuild of '$IMAGE_NAME'..."
    NEEDS_BUILD=true
else
    # Check if script has changed since last build
    STORED_HASH=$(docker image inspect "$IMAGE_NAME" --format '{{index .Config.Labels "script.hash"}}' 2>/dev/null)
    if [ "$SCRIPT_HASH" != "$STORED_HASH" ]; then
        echo "Script changed since last build. Rebuilding '$IMAGE_NAME'..."
        NEEDS_BUILD=true
    fi
fi

if [ "$NEEDS_BUILD" = true ]; then
    BUILD_DIR=$(mktemp -d)
    # Write Dockerfile
    cat > "$BUILD_DIR/Dockerfile" <<'DOCKERFILE'
FROM node:24-trixie

ARG CUSTOM_APT_PACKAGES

# Install base utilities and the docker CLI + compose plugin from Docker's
# official repo.  We do NOT install docker-ce or containerd - the daemon lives
# on the host and is reached via the bind-mounted socket.  The real CLI is
# moved out of $PATH; the shim at /usr/local/bin/docker takes over and
# filters every command by compose project label.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg build-essential \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
        | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian trixie stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        docker-ce-cli docker-compose-plugin \
    && if [ -n "$CUSTOM_APT_PACKAGES" ]; then \
        apt-get install -y --no-install-recommends $CUSTOM_APT_PACKAGES; \
    fi \
    && rm -rf /var/lib/apt/lists/*

# Move the real docker binary out of $PATH and install the filtering shim.
RUN install -d /usr/local/libexec \
    && mv /usr/bin/docker /usr/local/libexec/docker-real

COPY docker-shim /usr/local/bin/docker
RUN chmod 0755 /usr/local/bin/docker

# Compile the Landlock self-sandbox wrapper.  At runtime it seals the claude
# process tree (and every descendant, un-droppably) to the workspace + agent
# state + a read-only view of the rest of the rootfs, then exec's the real
# command.  build-essential (installed above) provides gcc + linux headers.
COPY landlock-exec.c /usr/local/src/landlock-exec.c
RUN gcc -O2 -Wall -o /usr/local/bin/landlock-exec /usr/local/src/landlock-exec.c \
    && chmod 0755 /usr/local/bin/landlock-exec

# Install crimson Ruby LSP server for the node user
COPY crimson /home/node/.local/bin/crimson
RUN chmod 0755 /home/node/.local/bin/crimson \
    && chown node:node /home/node/.local/bin/crimson

# Install Claude Code globally (available to all users)
RUN npm install -g @anthropic-ai/claude-code

ENV PATH="/home/node/.local/bin:${PATH}"

WORKDIR /workspace
CMD ["landlock-exec", "claude"]
DOCKERFILE

    # Write the docker shim that will be COPY'd into /usr/local/bin/docker.
    # Keep this in lockstep with the documentation in README.md.
    cat > "$BUILD_DIR/docker-shim" <<'SHIM'
#!/bin/bash
# claude-jail docker shim
#
# Filters access to the host docker daemon so that, from inside the jail, only
# containers belonging to the compose project rooted at this directory can be
# inspected, exec'd into, started, stopped, etc.  Host-wide operations
# (run/create/build/network/volume/system/...) are blocked outright.
#
# Scope is computed live from the docker daemon by querying for containers
# labeled
#     com.docker.compose.project.working_dir = $CLAUDE_JAIL_COMPOSE_WORKDIR
# (defaulting to the current working directory).  Containers brought up *after*
# the jail starts are picked up automatically.
#
# IMPORTANT: this shim is a soft fence, not a sandbox primitive.  Anything that
# can talk to /var/run/docker.sock directly (curl, a statically linked docker
# binary, an MCP server, etc.) bypasses it.  Treat it as a guard rail for an
# obedient agent, not a security boundary against an adversary.

set -uo pipefail

REAL_DOCKER="/usr/local/libexec/docker-real"
WORKDIR="${CLAUDE_JAIL_COMPOSE_WORKDIR:-$PWD}"
SHIM_NAME="claude-jail docker shim"

if ! [ -x "$REAL_DOCKER" ]; then
    echo "$SHIM_NAME: real docker binary missing at $REAL_DOCKER" >&2
    exit 127
fi

deny() {
    echo "$SHIM_NAME: refusing $*" >&2
    echo "$SHIM_NAME: scope = compose project working_dir=$WORKDIR" >&2
    exit 1
}

# Print every container name AND id (long + short) belonging to the project.
allowed_refs() {
    "$REAL_DOCKER" ps -a \
        --filter "label=com.docker.compose.project.working_dir=$WORKDIR" \
        --format '{{.Names}}{{"\t"}}{{.ID}}' 2>/dev/null \
    | awk -F'\t' 'NF>=2 { print $1; print $2; print substr($2,1,12) }'
}

# Cache the allowlist for one shim invocation so we only hit dockerd once.
_ALLOW_CACHE=""
get_allow() {
    if [ -z "$_ALLOW_CACHE" ]; then
        _ALLOW_CACHE="$(allowed_refs)"
        if [ -z "$_ALLOW_CACHE" ]; then
            _ALLOW_CACHE="__none__"
        fi
    fi
    [ "$_ALLOW_CACHE" = "__none__" ] || printf '%s\n' "$_ALLOW_CACHE"
}

is_allowed_ref() {
    local target="$1"
    [ -z "$target" ] && return 1
    get_allow | grep -qxF "$target"
}

# Verify that EVERY arg that successfully resolves to a container is in the
# allowlist.  Args that don't resolve as containers (flag values like 'root'
# after -u, image refs, command words after the container, etc.) are ignored.
verify_targets() {
    local arg ref
    local found_any=0
    for arg in "$@"; do
        case "$arg" in
            ''|--|-*) continue ;;
        esac
        # Strip 'container:/path' form used by docker cp
        ref="${arg%%:*}"
        if "$REAL_DOCKER" inspect --type=container "$ref" >/dev/null 2>&1; then
            found_any=1
            if ! is_allowed_ref "$ref"; then
                deny "container '$ref' is out of scope"
            fi
        fi
    done
    if [ "$found_any" = "0" ]; then
        deny "no in-scope container found in arguments"
    fi
}

CMD="${1:-}"

# Pass-through: meta and read-only globals
case "$CMD" in
    ''|help|--help|-h|version|--version|-v|info)
        exec "$REAL_DOCKER" "$@"
        ;;
esac

# Hard-blocked: anything that mutates the host outside the project
case "$CMD" in
    run|create|pull|push|build|buildx|builder|\
    image|images|rmi|save|load|import|export|tag|history|\
    network|volume|system|swarm|node|service|stack|secret|config|plugin|\
    context|login|logout|trust|search|commit|init|checkpoint)
        deny "'docker $CMD' is host-wide and not allowed from inside claude-jail"
        ;;
esac

# 'ps' is always force-scoped to the project label
if [ "$CMD" = "ps" ]; then
    shift
    exec "$REAL_DOCKER" ps \
        --filter "label=com.docker.compose.project.working_dir=$WORKDIR" "$@"
fi

# 'stats' with no positional target is rewritten to list project containers.
# With explicit targets it falls through to verify_targets below.
if [ "$CMD" = "stats" ]; then
    shift
    has_positional=0
    skip_next=0
    for arg in "$@"; do
        if [ "$skip_next" = "1" ]; then skip_next=0; continue; fi
        case "$arg" in
            --format|--format=*) [ "$arg" = "--format" ] && skip_next=1 ;;
            --) continue ;;
            -*) ;;
            *) has_positional=1; break ;;
        esac
    done
    if [ "$has_positional" = "0" ]; then
        ids=$("$REAL_DOCKER" ps -q \
            --filter "label=com.docker.compose.project.working_dir=$WORKDIR" 2>/dev/null)
        if [ -z "$ids" ]; then
            deny "no in-scope containers to stats"
        fi
        # shellcheck disable=SC2086
        exec "$REAL_DOCKER" stats "$@" $ids
    fi
    verify_targets "$@"
    exec "$REAL_DOCKER" stats "$@"
fi

# 'compose' is allowed but rejects flags that would escape the project root
if [ "$CMD" = "compose" ]; then
    shift
    for arg in "$@"; do
        case "$arg" in
            -f|--file|-f=*|--file=*|\
            --project-directory|--project-directory=*|\
            -p|--project-name|-p=*|--project-name=*|\
            --env-file|--env-file=*)
                deny "compose flag '$arg' would escape the project scope"
                ;;
        esac
    done
    cd "$WORKDIR" 2>/dev/null || true
    exec "$REAL_DOCKER" compose "$@"
fi

# Container-scoped commands: verify every container ref in args is in scope
case "$CMD" in
    exec|logs|inspect|top|stats|port|diff|\
    kill|stop|start|restart|pause|unpause|\
    rename|update|cp|wait|attach|rm)
        shift
        verify_targets "$@"
        exec "$REAL_DOCKER" "$CMD" "$@"
        ;;
esac

deny "'docker $CMD' is not recognized by the shim"
SHIM
    chmod +x "$BUILD_DIR/docker-shim"

    # Write the Landlock self-sandbox wrapper source.  Compiled in the
    # Dockerfile to /usr/local/bin/landlock-exec and used as the container
    # command prefix.  FILESYSTEM confinement only - no network rules, so the
    # jail keeps full access to compose services on arbitrary ports.  The
    # CLAUDE_JAIL_LANDLOCK env var selects enforce (default) / strict / off.
    cat > "$BUILD_DIR/landlock-exec.c" <<'LLSRC'
// claude-jail landlock-exec
//
// Self-sandboxing wrapper.  Installs a Landlock filesystem ruleset on the
// calling process (which propagates, un-droppably, to every descendant) and
// then execve()s the program named in argv[1..].  Used as the container
// command prefix so the `claude` process tree can only touch the workspace,
// the agent's own state, and a read-only view of the rest of the rootfs.
//
// FILESYSTEM ONLY.  No network rules are installed: claude-jail's headline
// feature is reaching compose services by name on arbitrary ports, and
// Landlock TCP rules are port-based, so confining them would cost that
// ability for little gain.
//
// Behaviour knob (env CLAUDE_JAIL_LANDLOCK):
//   unset / "enforce"  apply rules; if the kernel lacks Landlock, warn loudly
//                      and exec UNCONFINED (keeps claude-jail portable)
//   "strict"           any failure, including "kernel lacks Landlock", is fatal
//   "off"              skip Landlock entirely and exec directly
//
// A setup error *after* Landlock is known to be supported (add_rule /
// restrict_self failing) is ALWAYS fatal regardless of the knob -- that is a
// real fault, not an absent feature, and we must never silently run unconfined.

#define _GNU_SOURCE
#include <linux/landlock.h>
#include <sys/syscall.h>
#include <sys/prctl.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <stdint.h>

#ifndef __NR_landlock_create_ruleset
#define __NR_landlock_create_ruleset 444
#endif
#ifndef __NR_landlock_add_rule
#define __NR_landlock_add_rule 445
#endif
#ifndef __NR_landlock_restrict_self
#define __NR_landlock_restrict_self 446
#endif

#define PROG "landlock-exec"

static long ll_create_ruleset(const struct landlock_ruleset_attr *attr,
                              size_t size, uint32_t flags) {
    return syscall(__NR_landlock_create_ruleset, attr, size, flags);
}
static long ll_add_rule(int fd, enum landlock_rule_type t,
                        const void *attr, uint32_t flags) {
    return syscall(__NR_landlock_add_rule, fd, t, attr, flags);
}
static long ll_restrict_self(int fd, uint32_t flags) {
    return syscall(__NR_landlock_restrict_self, fd, flags);
}

// All filesystem access rights, grouped.  We "handle" (i.e. deny-by-default)
// the full set, then grant subsets per path.
#define LL_READ ( \
    LANDLOCK_ACCESS_FS_EXECUTE | \
    LANDLOCK_ACCESS_FS_READ_FILE | \
    LANDLOCK_ACCESS_FS_READ_DIR )

#define LL_WRITE ( \
    LANDLOCK_ACCESS_FS_WRITE_FILE | \
    LANDLOCK_ACCESS_FS_REMOVE_DIR | \
    LANDLOCK_ACCESS_FS_REMOVE_FILE | \
    LANDLOCK_ACCESS_FS_MAKE_CHAR | \
    LANDLOCK_ACCESS_FS_MAKE_DIR | \
    LANDLOCK_ACCESS_FS_MAKE_REG | \
    LANDLOCK_ACCESS_FS_MAKE_SOCK | \
    LANDLOCK_ACCESS_FS_MAKE_FIFO | \
    LANDLOCK_ACCESS_FS_MAKE_BLOCK | \
    LANDLOCK_ACCESS_FS_MAKE_SYM | \
    LANDLOCK_ACCESS_FS_REFER | \
    LANDLOCK_ACCESS_FS_TRUNCATE )

// Rights that are meaningful for a regular (non-directory) file.
#define LL_FILE ( \
    LANDLOCK_ACCESS_FS_EXECUTE | \
    LANDLOCK_ACCESS_FS_READ_FILE | \
    LANDLOCK_ACCESS_FS_WRITE_FILE | \
    LANDLOCK_ACCESS_FS_TRUNCATE )

static int g_strict = 0;

static void fatal(const char *what) {
    fprintf(stderr, PROG ": %s: %s\n", what, strerror(errno));
    _exit(125);
}

// Grant `access` on `path`.  Missing paths (ENOENT) are skipped silently --
// the allowlist is a superset covering several layouts.  Any *other* failure
// is fatal: a half-applied ruleset must never fall through to an exec.
static void grant(int ruleset_fd, const char *path, uint64_t access) {
    int fd = open(path, O_PATH | O_CLOEXEC);
    if (fd < 0) {
        if (errno == ENOENT)
            return;
        fprintf(stderr, PROG ": open %s: %s\n", path, strerror(errno));
        _exit(125);
    }
    struct stat st;
    if (fstat(fd, &st) == 0 && !S_ISDIR(st.st_mode))
        access &= LL_FILE;   // directory-only rights are EINVAL on a file

    struct landlock_path_beneath_attr pb = {
        .allowed_access = access,
        .parent_fd = fd,
    };
    if (ll_add_rule(ruleset_fd, LANDLOCK_RULE_PATH_BENEATH, &pb, 0)) {
        fprintf(stderr, PROG ": add_rule %s: %s\n", path, strerror(errno));
        close(fd);
        _exit(125);
    }
    close(fd);
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, PROG ": usage: " PROG " PROGRAM [ARGS...]\n");
        return 125;
    }

    const char *mode = getenv("CLAUDE_JAIL_LANDLOCK");
    if (mode && strcmp(mode, "off") == 0)
        goto run;                       // explicit escape hatch
    if (mode && strcmp(mode, "strict") == 0)
        g_strict = 1;

    // Probe Landlock and learn the kernel's max ABI so we only request rights
    // the kernel understands.
    long abi = ll_create_ruleset(NULL, 0, LANDLOCK_CREATE_RULESET_VERSION);
    if (abi < 0) {
        if (g_strict)
            fatal("Landlock unavailable and CLAUDE_JAIL_LANDLOCK=strict");
        fprintf(stderr, PROG ": WARNING: kernel has no usable Landlock "
                        "(%s); running UNCONFINED\n", strerror(errno));
        goto run;
    }

    uint64_t handled = LL_READ | LL_WRITE;
    if (abi < 2) handled &= ~LANDLOCK_ACCESS_FS_REFER;
    if (abi < 3) handled &= ~LANDLOCK_ACCESS_FS_TRUNCATE;

    uint64_t rx  = LL_READ & handled;              // read + execute, no write
    uint64_t rwx = (LL_READ | LL_WRITE) & handled; // full read/write/create + exec

    struct landlock_ruleset_attr attr = { .handled_access_fs = handled };
    int ruleset_fd = ll_create_ruleset(&attr, sizeof(attr), 0);
    if (ruleset_fd < 0)
        fatal("landlock_create_ruleset");

    // Read-only + execute: the rest of the rootfs.  No write right is granted,
    // so the agent cannot overwrite the docker shim, the claude binary, or any
    // system file -- only read and execute them.
    static const char *ro[] = {
        "/usr", "/bin", "/sbin", "/lib", "/lib64", "/lib32", "/libx32",
        "/opt", "/etc", NULL,
    };
    for (int i = 0; ro[i]; i++) grant(ruleset_fd, ro[i], rx);

    // Read-only, no execute: kernel/pseudo filesystems tools introspect.
    static const char *rd[] = { "/proc", "/sys", NULL };
    for (int i = 0; rd[i]; i++)
        grant(ruleset_fd, rd[i],
              (LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_READ_DIR) & handled);

    // Read/write/create + execute: workspace, agent state, scratch, devices,
    // and the runtime dir (docker.sock lives here in the mounted-socket model).
    // Execute is granted on /tmp and the home tree so npx/build caches and
    // freshly compiled test binaries still run.
    static const char *rw[] = {
        "/home/node", "/tmp", "/var/tmp", "/dev", "/run", "/var/run", NULL,
    };
    for (int i = 0; rw[i]; i++) grant(ruleset_fd, rw[i], rwx);

    // The workspace mount.  Prefer the explicit launcher-provided path; fall
    // back to the current directory when run standalone.
    const char *workdir = getenv("CLAUDE_JAIL_COMPOSE_WORKDIR");
    if (workdir && workdir[0])
        grant(ruleset_fd, workdir, rwx);
    char cwd[4096];
    if (getcwd(cwd, sizeof(cwd)))
        grant(ruleset_fd, cwd, rwx);

    // Belt-and-suspenders: name the known sub-mounts explicitly in case they
    // sit on their own mount under /home/node.
    grant(ruleset_fd, "/home/node/.claude", rwx);
    grant(ruleset_fd, "/home/node/.claude.json", rwx);

    if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0))
        fatal("prctl(PR_SET_NO_NEW_PRIVS)");
    if (ll_restrict_self(ruleset_fd, 0))
        fatal("landlock_restrict_self");
    close(ruleset_fd);

run:
    execvp(argv[1], &argv[1]);
    fprintf(stderr, PROG ": exec %s: %s\n", argv[1], strerror(errno));
    return 127;
}
LLSRC

    # Copy the crimson Ruby LSP binary into the build context
    cp "$(dirname "$SCRIPT_PATH")/crimson" "$BUILD_DIR/crimson"

    BUILD_ARGS=(
      --build-arg "CUSTOM_APT_PACKAGES=$CUSTOM_APT_PACKAGES"
      --label "script.hash=$SCRIPT_HASH"
      -t "$IMAGE_NAME"
    )
    if [ "$NO_CACHE" = true ]; then
        BUILD_ARGS+=(--no-cache)
    fi
    docker build "${BUILD_ARGS[@]}" "$BUILD_DIR"
    rm -rf "$BUILD_DIR"
fi

# ---------------------------------------------------------------------------
# Compose project detection.
#
# claude-jail mounts the host docker socket into the jail container so that
# claude can `docker exec`, `docker logs`, `docker compose ps` etc. against
# the user's already-running compose stack.  To keep the blast radius narrow,
# the docker CLI inside the image is replaced by a shim (see docker-shim
# above) that filters every command by the compose project label
#     com.docker.compose.project.working_dir = $(pwd)
#
# Here, on the host, we also:
#   * enumerate the docker networks those compose containers are on and
#     attach the jail container to the same networks (so DNS service-name
#     resolution works), and
#   * build a CLAUDE.md-style scope description listing every allowed
#     container, which we hand to claude via --append-system-prompt.
# ---------------------------------------------------------------------------

detect_compose_containers() {
    docker ps -a \
        --filter "label=com.docker.compose.project.working_dir=$HOST_PWD" \
        --format '{{.Names}}' 2>/dev/null
}

detect_compose_networks() {
    local cids cid
    cids=$(docker ps -q --filter "label=com.docker.compose.project.working_dir=$HOST_PWD" 2>/dev/null)
    if [ -z "$cids" ]; then
        return
    fi
    for cid in $cids; do
        docker inspect "$cid" \
            --format '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}}{{"\n"}}{{end}}' \
            2>/dev/null
    done | awk 'NF && !seen[$0]++'
}

mapfile -t COMPOSE_CONTAINERS < <(detect_compose_containers)
mapfile -t COMPOSE_NETWORKS < <(detect_compose_networks)

# Combine auto-detected networks with any -n/--network overrides, deduped,
# detected first so the first --network of `docker create` is a real compose
# network when one exists.
ALL_NETWORKS=()
declare -A _seen_net=()
for net in "${COMPOSE_NETWORKS[@]}" "${EXTRA_NETWORKS[@]}"; do
    [ -z "$net" ] && continue
    [ -n "${_seen_net[$net]:-}" ] && continue
    _seen_net[$net]=1
    ALL_NETWORKS+=("$net")
done
unset _seen_net

if [ ${#ALL_NETWORKS[@]} -eq 0 ]; then
    echo "Warning: no running compose project detected for $HOST_PWD" >&2
    echo "         the jail container will start with only the default bridge network." >&2
    echo "         Run 'docker compose up -d' first to expose your services to claude," >&2
    echo "         or pass -n/--network NAME to attach an existing docker network." >&2
else
    echo "Attaching jail to networks: ${ALL_NETWORKS[*]}"
fi

if [ ${#COMPOSE_CONTAINERS[@]} -gt 0 ]; then
    echo "Compose containers in scope: ${COMPOSE_CONTAINERS[*]}"
fi

# Build the CLAUDE.md-style scope text that we feed to claude via
# --append-system-prompt.  This is the agent-facing half of the scope rule;
# the docker shim is the mechanical half.
build_scope_prompt() {
    printf '# claude-jail docker scope\n\n'
    printf 'You are running inside claude-jail, a sandboxed Docker environment.\n'
    printf 'A filtering docker shim is installed at /usr/local/bin/docker.\n\n'
    printf 'The shim only permits docker operations against containers belonging\n'
    printf 'to the docker compose project rooted at:\n\n'
    printf '    %s\n\n' "$HOST_PWD"
    if [ ${#COMPOSE_CONTAINERS[@]} -gt 0 ]; then
        printf '## Allowed containers (live at launch time)\n\n'
        for c in "${COMPOSE_CONTAINERS[@]}"; do
            printf '  - %s\n' "$c"
        done
        printf '\n'
        printf 'Containers brought up after launch are also permitted as long as\n'
        printf 'compose tags them with the same project working_dir.\n\n'
    else
        printf '## No compose project detected at launch time\n\n'
        printf 'There is currently no docker compose project running with\n'
        printf 'working_dir=%s.  The shim will reject every container\n' "$HOST_PWD"
        printf 'operation until a compose stack is brought up on the host with\n'
        printf '`docker compose up -d`.\n\n'
    fi
    printf '## Allowed docker commands\n\n'
    printf '  - `docker ps` (auto-scoped to the project)\n'
    printf '  - `docker exec|logs|inspect|top|stats|port|diff|cp|wait|attach <ctr>`\n'
    printf '  - `docker stop|start|restart|kill|pause|unpause|rename|update|rm <ctr>`\n'
    printf '  - `docker compose <subcommand>` (always against this directory)\n'
    printf '  - `docker version|info|help`\n\n'
    printf '## Blocked docker commands\n\n'
    printf '  - `docker run|create|build|pull|push|tag|save|load|history|commit`\n'
    printf '  - `docker image|images|volume|network|system|swarm|service|stack`\n'
    printf '  - `docker secret|config|plugin|context|login|logout|trust|search`\n'
    printf '  - `docker compose -f|-p|--project-directory|--env-file` (scope escape)\n'
    printf '  - any operation against a container outside the allowlist above\n\n'
    printf 'If you need a host-wide operation, ask the user to run it on the host.\n'
    printf 'Do not try to bypass the shim by talking to /var/run/docker.sock\n'
    printf 'directly with curl or a static binary.\n\n'
    printf '## Filesystem confinement (Landlock)\n\n'
    printf 'Your process tree is sealed by Landlock.  You can read and execute the\n'
    printf 'whole rootfs but can only WRITE to:\n'
    printf '  - the workspace at %s\n' "$HOST_PWD"
    printf '  - your state dir ~/.claude and ~/.claude.json\n'
    printf '  - /tmp, /var/tmp, and your home cache dirs\n'
    printf 'Writes elsewhere (e.g. /usr, /etc, the docker shim) fail with EACCES by\n'
    printf 'design.  This is expected; do not try to work around it.\n'
}

SCOPE_PROMPT="$(build_scope_prompt)"

# Cleanup: with `docker create --rm` the container auto-removes when
# `docker start -a` returns, so the trap is only needed to catch the cases
# where the script fails between `create` and `start`, or is killed by a
# signal before the container ever runs.
JAIL_CID=""
cleanup_jail() {
    if [ -n "$JAIL_CID" ]; then
        docker rm -f "$JAIL_CID" >/dev/null 2>&1 || true
    fi
}
trap cleanup_jail EXIT

# Build the docker create command.
# - The jail container runs as the host UID/GID so file ownership in the
#   workspace mount and the claude-home mount stays consistent and so claude
#   does not refuse to use --dangerously-skip-permissions (it errors out as
#   root).
# - claude-home directories are mounted so claude state persists across runs.
# - HOME is set explicitly so claude resolves ~/.claude to the mounted
#   /home/node/.claude directory.
# - The host docker socket IS mounted; the shim at /usr/local/bin/docker
#   filters every command by compose project label.  See the security note
#   in README.md - this is a soft fence.
# - --group-add of the host's docker gid lets the in-container user (host UID)
#   read/write the bind-mounted socket without needing root.
# - `-t` is only added when stdin/stdout are real TTYs to avoid Docker's
#   "the input device is not a TTY" error in non-interactive contexts.
TTY_FLAGS=(-i)
if [ -t 0 ] && [ -t 1 ]; then
    TTY_FLAGS+=(-t)
fi

# Find the host docker socket and its group so the in-container user can use it.
HOST_DOCKER_SOCK=""
for candidate in /var/run/docker.sock /run/docker.sock; do
    if [ -S "$candidate" ]; then
        HOST_DOCKER_SOCK="$candidate"
        break
    fi
done
if [ -z "$HOST_DOCKER_SOCK" ]; then
    echo "Warning: no docker socket found at /var/run/docker.sock or /run/docker.sock;" >&2
    echo "         the docker shim inside the jail will fail." >&2
fi
DOCKER_SOCK_GID=""
if [ -n "$HOST_DOCKER_SOCK" ]; then
    DOCKER_SOCK_GID=$(stat -c '%g' "$HOST_DOCKER_SOCK" 2>/dev/null || true)
fi

DOCKER_ARGS=(
  "${TTY_FLAGS[@]}" --rm
  --user "$(id -u):$(id -g)"
  --cap-drop=ALL
  --security-opt=no-new-privileges
  --label "hostdir=$HOST_PWD"
  -v "$HOST_PWD:$HOST_PWD"
  -v "$claude_data/.claude:/home/node/.claude"
  -v "$claude_data/.claude.json:/home/node/.claude.json"
  -w "$HOST_PWD"
  -e HOME=/home/node
  -e CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
  -e CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
  -e DISABLE_AUTOUPDATER=1
  -e IS_DEMO=1
  -e "CLAUDE_JAIL_COMPOSE_WORKDIR=$HOST_PWD"
)

if [ -n "$HOST_DOCKER_SOCK" ]; then
    DOCKER_ARGS+=(-v "$HOST_DOCKER_SOCK:/var/run/docker.sock")
fi
if [ -n "$DOCKER_SOCK_GID" ]; then
    DOCKER_ARGS+=(--group-add "$DOCKER_SOCK_GID")
fi

# Attach the first network at create time; remaining networks are attached
# via `docker network connect` between create and start.
if [ ${#ALL_NETWORKS[@]} -gt 0 ]; then
    DOCKER_ARGS+=(--network "${ALL_NETWORKS[0]}")
fi

# Append user-supplied environment variables
for env_var in "${ENV_VARS[@]}"; do
    DOCKER_ARGS+=(-e "$env_var")
done

# Build claude arguments from parsed options.
# --dangerously-skip-permissions is passed by default (claude runs inside an
# isolated container anyway); use --safe to opt out.
CLAUDE_ARGS=()
if [ "$SAFE_PERMISSIONS" != true ]; then
    CLAUDE_ARGS+=(--dangerously-skip-permissions)
fi
CLAUDE_ARGS+=(--append-system-prompt "$SCOPE_PROMPT")
if [ -n "$RESUME_SESSION" ]; then
    CLAUDE_ARGS+=(--resume "$RESUME_SESSION")
elif [ "$CONTINUE_SESSION" = true ]; then
    CLAUDE_ARGS+=(--continue)
fi

# --shell mode: if a jail container is already running for this hostdir,
# `docker exec` into it.  This path bypasses the create/start dance entirely
# and intentionally does not run the EXIT trap (the existing container is
# owned by another invocation).
if [ "$SHELL_MODE" = true ]; then
    EXISTING=$(docker ps -q --filter "label=hostdir=$HOST_PWD" --filter "ancestor=$IMAGE_NAME" | head -1)
    if [ -n "$EXISTING" ]; then
        trap - EXIT
        # Wrap with landlock-exec so an exec'd debug shell is confined the same
        # way the agent is.  Pass CLAUDE_JAIL_LANDLOCK=off via -e to opt out.
        exec docker exec "${TTY_FLAGS[@]}" "$EXISTING" landlock-exec bash
    fi
fi

# Create the container (not yet running) so we can attach extra networks
# before start.
set +e
# Every command is prefixed with landlock-exec so the process tree is sealed
# to the workspace + agent state before the real program starts.  The bare
# default branch relies on the image CMD (also landlock-exec claude).
if [ "$SHELL_MODE" = true ]; then
    JAIL_CID=$(docker create "${DOCKER_ARGS[@]}" "$IMAGE_NAME" landlock-exec bash)
elif [ ${#CLAUDE_ARGS[@]} -gt 0 ] || [ ${#PASSTHROUGH_ARGS[@]} -gt 0 ]; then
    JAIL_CID=$(docker create "${DOCKER_ARGS[@]}" "$IMAGE_NAME" landlock-exec claude "${CLAUDE_ARGS[@]}" "${PASSTHROUGH_ARGS[@]}")
else
    JAIL_CID=$(docker create "${DOCKER_ARGS[@]}" "$IMAGE_NAME")
fi
CREATE_RC=$?
set -e

if [ "$CREATE_RC" -ne 0 ] || [ -z "$JAIL_CID" ]; then
    echo "ERROR: docker create failed (status $CREATE_RC)" >&2
    exit "${CREATE_RC:-1}"
fi

# Connect the remaining networks (index 0 was already attached at create).
for ((i=1; i<${#ALL_NETWORKS[@]}; i++)); do
    if ! docker network connect "${ALL_NETWORKS[$i]}" "$JAIL_CID" >/dev/null 2>&1; then
        echo "Warning: failed to attach to network '${ALL_NETWORKS[$i]}'" >&2
    fi
done

# Start the container in the foreground.  --rm on create takes care of
# removing it once `docker start -a` returns.
set +e
docker start -a -i "$JAIL_CID"
RUN_RC=$?
set -e

if [ "${RUN_RC:-0}" -ne 0 ]; then
    echo "claude container exited with status ${RUN_RC}" >&2
fi
exit "${RUN_RC:-0}"
